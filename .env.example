# Server Configuration
PORT=5000
NODE_ENV=development
API_VERSION=v1

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/sleepfineCRM_DEV
MONGODB_URI_TEST=mongodb://localhost:27017/sleepfineCRM_test

# Redis Configuration (set REDIS_ENABLED=false to use in-memory cache without Redis server)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=sleepfine-dev-super-secret-jwt-key-2024
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=sleepfine-dev-super-secret-refresh-key-2024
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:4200
CORS_CREDENTIALS=true

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
SLOW_DOWN_WINDOW_MS=900000
SLOW_DOWN_DELAY_AFTER=100
SLOW_DOWN_DELAY_MS=500

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# WhatsApp & Notifications
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Google Sheets Configuration
GOOGLE_SHEETS_WARRANTY_URL=https://script.google.com/macros/s/AKfycbzgGYjZQD0m-En0jnBU7L3G9izay9UHq0G3--8HdEcgCl_Vo-yIcK7evT-OL7QhczU59Q/exec

# AWS Configuration (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=sleepfine-bucket
